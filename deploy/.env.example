# PostgreSQL
POSTGRES_DB=acreon
POSTGRES_USER=acreon
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public application URL
ALLOWED_ORIGIN=https://acreon.house-of-hall.com
WEB_PORT=8080

# Frontend build settings
BASE_PATH=/
VITE_CLERK_PROXY_URL=/api/__clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Backend Clerk settings
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Google OAuth
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# OpenAI-compatible integration
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Logging
LOG_LEVEL=info

# Leave blank outside Replit
REPLIT_DEV_DOMAIN=

# Comma-separated Clerk user IDs permitted to provision themselves as admins.
# Leave empty to disable self-service admin provisioning.
ADMIN_BOOTSTRAP_USER_IDS=

# Required for email credentials: generate with openssl rand -hex 32.
# Store securely and retain across deployments; changing it requires reconnection.
EMAIL_CREDENTIAL_ENCRYPTION_KEY=
